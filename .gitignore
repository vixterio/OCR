# Document corpora and anything derived from them. Synthetic or not, these are
# patient-shaped records -- names, dates of birth, insurance numbers -- and they
# do not belong in a public repository. The ignore covers the bundles, their
# manifests, and every scored result, because a score file quotes the text it
# scored.
merged_bundles/
*.pdf
!test_record.pdf
manifest.json
bulk_upload_manifest.json
scores/

# Per-document extractions, OCR transcripts and HTML comparisons. All of it is
# derived from patient-shaped records -- an extracted PDF is a page of one, and a
# comparison report quotes both sides -- so none of it belongs in the repository.
work/
.DS_Store
